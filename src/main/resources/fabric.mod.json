{
  "schemaVersion": 1,
  "id": "renderfast",
  "version": "${version}",
  "name": "RenderFast",
  "description": "High-performance chunk pre-generator that eliminates loading stutter by pre-generating terrain.",
  "authors": [
    "You"
  ],
  "license": "ARR",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.example.renderfast.RenderFast"
    ],
    "client": [
      "com.example.renderfast.RenderFastClient"
    ],
    "modmenu": [
      "com.example.renderfast.RenderFastMenu"
    ]
  },
  "mixins": [
    "renderfast.mixins.json",
    {
      "config": "renderfast.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
